# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key, used for AI quiz drafts (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Code people must enter to sign up as an instructor
INSTRUCTOR_INVITE_CODE=teach2026

# Password for the seeded demo accounts. When set, the login page shows one-click demo buttons.
NEXT_PUBLIC_DEMO_PASSWORD=codequest-demo
